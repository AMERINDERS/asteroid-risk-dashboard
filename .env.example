# Copy this file to .env and fill in your real values
# NEVER commit the real .env file

# NASA API (get free key at api.nasa.gov)
NASA_API_KEY=your_nasa_api_key_here

# Database (local Docker — use these exact values for local dev)
DATABASE_URL=postgresql://asteroid:asteroid@localhost:5432/asteroids

# Redis (local Docker)
REDIS_URL=redis://localhost:6379

# AWS (from your IAM user CSV)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Sentry (get free DSN at sentry.io — add in Phase 6)
SENTRY_DSN=your_sentry_dsn_here